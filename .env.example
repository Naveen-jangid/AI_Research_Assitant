# ─────────────────────────────────────────────────────────────────────────────
# AI Research Assistant – Environment Configuration
# Copy this file to `.env` and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "openai" | "anthropic" | "ollama"
LLM_PROVIDER=openai

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini          # or gpt-4o, gpt-3.5-turbo

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6  # or claude-opus-4-6, claude-haiku-4-5-20251001

# ── Ollama (local, no API key needed) ────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3               # any model pulled via `ollama pull <model>`

# ── Embeddings ───────────────────────────────────────────────────────────────
# Options: "openai" | "huggingface"
# Use "huggingface" for a fully local/free setup.
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5  # fast & accurate

# ── Vector Store ─────────────────────────────────────────────────────────────
# Options: "chroma" | "faiss"
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./chroma_db

# ── RAG Settings ─────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_RETRIEVAL=5

# ── App Settings ─────────────────────────────────────────────────────────────
APP_TITLE=AI Research Assistant
MAX_FILE_SIZE_MB=50
